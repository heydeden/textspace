# TextSpace — env contoh (copy ke .env.local lalu isi nilai asli)
# JANGAN commit nilai asli. Salin: cp .env.example .env.local

# --- Wajib (runtime + test lokal) ---
# Dari Vercel project textspace → Storage (Neon) atau `vercel env pull`.
DATABASE_URL=postgres://USER:PASSWORD@HOST/neondb?sslmode=require
# JWT signing secret — panjang & acak. Dari `vercel env pull`.
JWT_SECRET=generate-panjang-acak

# --- Opsional (hanya kalau mau aktifkan) ---
# Aktifkan endpoint POST /api/initdb (default nonaktif). Jangan di prod.
ALLOW_INITDB=false
# Aktifkan POST /api/admin/recover — bikin akun login pertama jadi admin (default nonaktif).
ENABLE_ADMIN_RECOVERY=false

# --- CI (GitHub Actions) — SET di Settings → Secrets, bukan .env ---
# DATABASE_URL          — wajib (job integration + db-sweep, main-only)
# TEST_ADMIN_PASSWORD   — password akun admin test `ci_admin` yang di-seed CI
# TEST_ADMIN_USERNAME   — opsional, default ci_admin
